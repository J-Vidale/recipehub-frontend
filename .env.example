# RecipeHub web client - environment variables
#
# Vite inlines anything prefixed VITE_ into the built JavaScript at build
# time. Treat every value here as public: it ships to the browser. Nothing
# secret belongs in this file.
#
# In production these are set in the Render dashboard (Static Site ->
# Environment). A change only takes effect on the next build.

# --- Required in production -----------------------------------------------

# The API's base URL, including the /api path. There is no production
# default: left unset, the built site calls http://localhost:5000/api and
# fails for every visitor. Leaving /api off the end is fine - it is added -
# but the host has to be right. The Socket.IO connection derives its origin
# from this too.
#   VITE_API_URL=https://recipehub-backend-xxxx.onrender.com/api
VITE_API_URL=

# --- Required once you attach a custom domain -----------------------------

# The site's real public origin, no trailing slash. Everything that needs
# an absolute URL reads this: canonical tags, Open Graph and Twitter cards,
# the JSON-LD, robots.txt, sitemap.xml and llms.txt. Leaving it unset after
# attaching a domain tells search engines the canonical home is still the
# old Render URL.
#   VITE_SITE_URL=https://recipehub.com
VITE_SITE_URL=

# --- Optional -------------------------------------------------------------

# Shown in the footer and on the Terms and Privacy pages. Both are blank by
# default, and those pages render no contact block at all rather than
# shipping a placeholder address. Terms and Privacy both need a way to
# reach you, so fill at least the email in before pointing a real domain
# at this.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Browser error reporting. Create a project at sentry.io (React platform)
# and paste its DSN. Unset means the SDK is never even downloaded.
VITE_SENTRY_DSN=
